@model MVC.Models.DetalleCompra
@{
    ViewData["Title"] = "Confirmación de Compra";
}

<div class="container py-5 text-center">
    @if (Model == null || Model.VideoJuego == null)
    {
        <div class="gs-card p-5">
            <i class="fa-solid fa-triangle-exclamation fa-3x text-warning mb-3"></i>
            <h3>Ups, no pudimos cargar el resumen</h3>
            <p>Pero no te preocupes, tu compra fue procesada con éxito. Revisa tu biblioteca.</p>
            <a asp-action="MisCompras" class="btn-gs-primary">Ir a Mis Compras</a>
        </div>
    }
    else
    {
        <div class="gs-card d-inline-block p-5" style="max-width: 550px; border-top: 4px solid var(--success);">
            <i class="fa-solid fa-circle-check fa-5x text-success mb-4"></i>
            <h2 class="gs-page-title mb-3">¡Compra Exitosa!</h2>
            <p class="text-muted small mb-4">El videojuego ha sido añadido a tu biblioteca permanentemente.</p>
            
            @* --- RESUMEN TIPO TICKET --- *@
            <div class="text-start mt-4 p-4 rounded-3" style="background: var(--surface2);">
                @* Encabezado con imagen *@
                <div class="d-flex align-items-center mb-4 pb-3" style="border-bottom: 1px solid var(--border);">
                    <img src="@(Model.VideoJuego?.imagen ?? "/img/default.png")"
                         alt="@Model.VideoJuego?.Titulo"
                         style="width: 80px; height: 45px; object-fit: cover; border-radius: 4px;" class="me-3" />
                    <div>
                        <div class="text-muted small fw-bold text-uppercase" style="font-size: 0.65rem;">Producto</div>
                        <div class="fw-bold">@Model.VideoJuego?.Titulo</div>
                    </div>
                </div>

                @* Datos de la transacción *@
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase" style="font-size: 0.65rem;">Transacción</span>
                    <span class="small" style="color: var(--accent);">@Model.codigoTransaccion</span>
                </div>
                
                <div class="d-flex justify-content-between mb-4">
                    <span class="text-muted small fw-bold text-uppercase" style="font-size: 0.65rem;">Fecha</span>
                    <span class="small">@Model.fechaHoraTransaccion.ToString("dd/MM/yyyy HH:mm")</span>
                </div>

                @* Total resaltado *@
                <div class="d-flex justify-content-between align-items-center pt-3" style="border-top: 1px dashed var(--border);">
                    <span class="fw-bold">Total Pagado:</span>
                    <span class="fs-4 fw-bold text-success">$@Model.total</span>
                </div>
            </div>

            <div class="d-grid gap-3 mt-4">
                <a asp-action="MisCompras" class="btn-gs-primary py-3">
                    <i class="fa-solid fa-gamepad me-2"></i>Ver mi biblioteca
                </a>
                <a asp-controller="Home" asp-action="Catalogo" class="btn-gs-secondary">
                    Seguir comprando
                </a>
            </div>
        </div>
    }
</div>