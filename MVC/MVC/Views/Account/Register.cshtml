@{
    ViewData["Title"] = "Crear Cuenta";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="col-md-6 col-lg-5">
        <div style="background: var(--surface2); padding: 2.5rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); box-shadow: 0 8px 32px rgba(0,0,0,0.3);">
            
            <div class="text-center mb-4">
                <h2 style="font-family:'Rajdhani',sans-serif; color:var(--text); font-size:2.2rem; font-weight: 700;">
                    Únete a <span style="color:var(--accent);">GameStore</span>
                </h2>
                <p style="color: var(--muted); font-size: 0.95rem;">Crea tu cuenta gratis y comienza a jugar.</p>
            </div>

            <form asp-controller="Account" asp-action="Register" method="post">
                <div class="mb-3">
                    <label class="form-label" style="color:var(--muted); font-size:0.85rem; font-weight:bold;">Nombre completo</label>
                    <input type="text" name="nombre" class="form-control" style="background:var(--surface); border:1px solid rgba(255,255,255,0.1); color:var(--text);" placeholder="Ej. Orlando Zúniga" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" style="color:var(--muted); font-size:0.85rem; font-weight:bold;">Correo electrónico</label>
                    <input type="email" name="email" class="form-control" style="background:var(--surface); border:1px solid rgba(255,255,255,0.1); color:var(--text);" placeholder="tu@email.com" required />
                </div>
                <div class="mb-4">
                    <label class="form-label" style="color:var(--muted); font-size:0.85rem; font-weight:bold;">Contraseña</label>
                    <input type="password" name="password" class="form-control" style="background:var(--surface); border:1px solid rgba(255,255,255,0.1); color:var(--text);" placeholder="••••••••" required />
                </div>
                <button type="submit" class="btn-gs-primary w-100" style="padding: 0.75rem; font-size: 1.05rem; border:none; border-radius:6px;">
                    <i class="fa-solid fa-user-plus me-2"></i>Registrarme
                </button>
            </form>
            
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3 mb-0" style="font-size: 0.85rem; padding: 0.6rem; background-color: rgba(220, 53, 69, 0.1); border: 1px solid var(--danger); color: #ff6b6b; text-align: center;">
                    <i class="fa-solid fa-circle-exclamation me-1"></i> @ViewBag.Error
                </div>
            }

            <div class="text-center mt-4 pt-3" style="border-top: 1px solid rgba(255,255,255,0.05);">
                <p style="color: var(--muted); font-size: 0.9rem;">
                    ¿Ya tienes una cuenta? <a asp-controller="Account" asp-action="Login" style="color: var(--accent); text-decoration: none; font-weight: bold;">Inicia sesión aquí</a>
                </p>
            </div>

        </div>
    </div>
</div>