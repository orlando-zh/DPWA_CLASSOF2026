<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GameStore</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
            :root {
                --bg: #0d0f14;
                --surface: #161922;
                --surface2: #1e2330;
                --border: #2a3040;
                --accent: #f0a500;
                --accent2: #e05c2a;
                --text: #e8eaf0;
                --muted: #6b7280;
                --success: #22c55e;
                --danger: #ef4444;
                --info: #38bdf8;
            }

            body {
                background: var(--bg);
                color: var(--text);
                font-family: 'Inter', sans-serif;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            h1, h2, h3, h4, h5, h6 {
                font-family: 'Rajdhani', sans-serif;
                letter-spacing: 0.02em;
            }
    </style>
</head>
<body>
    @* --- OPTIMIZACIÓN DE SESIÓN: Lectura única para evitar crashes --- *@
    @{
        var userSession = Context.Session.GetString("Usuario");
        var userRol = Context.Session.GetInt32("idrol");
    }

    <nav class="gs-nav navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-gamepad me-2"></i>GameStore
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNavbar">
                <span class="navbar-toggler-icon" style="filter: invert(0.8);"></span>
            </button>
            <div class="collapse navbar-collapse" id="menuNavbar">
                
                <ul class="navbar-nav me-auto gap-1">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                    </li>

                    @* MENÚ PARA ADMINISTRADORES (Rol 1) *@
                    @if (userRol == 1)
                    {
                        <li class="nav-item">
                            <a class="nav-link admin-link" asp-controller="VideoJuegos" asp-action="Inventario">
                                <i class="fa-solid fa-boxes-stacked me-1"></i>Inventario
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link admin-link" asp-controller="Categorias" asp-action="Index">
                                <i class="fa-solid fa-tags me-1"></i>Categorías
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link admin-link" asp-controller="Promociones" asp-action="Index">
                                <i class="fa-solid fa-tag me-1"></i>Promociones
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link admin-link" asp-controller="Account" asp-action="Dashboard">
                                <i class="fa-solid fa-chart-line me-1"></i>Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link admin-link" asp-controller="Account" asp-action="DetalleVentas" style="white-space:nowrap;">
                                <i class="fa-solid fa-receipt me-1"></i>Ventas
                            </a>
                        </li>
                    }

                    @* MENÚ PARA CLIENTES (Rol 2) O INVITADOS *@
                    @if (userRol == 2 || string.IsNullOrEmpty(userSession))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Catalogo">Tienda</a>
                        </li>

                        @if (!string.IsNullOrEmpty(userSession))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="MisCompras">
                                    Mis Compras
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Promociones">Ofertas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contacts">Contacto</a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav ms-auto align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(userSession))
                    {
                        @* UN SOLO ENLACE QUE CONTIENE NOMBRE E ICONO *@
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2" asp-controller="Account" asp-action="Perfil" title="Mi Perfil">
                                <span class="user-greeting">
                                    <i class="fa-solid fa-circle-user me-1"></i>@userSession
                                </span>
                                <i class="fa-solid fa-gear" style="font-size: 0.85rem; opacity: 0.7;"></i>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Logout" style="color: var(--danger) !important; opacity: 0.8;">
                                <i class="fa-solid fa-power-off me-1"></i>Salir
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn-register" asp-controller="Account" asp-action="Register">Registrarse</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="gs-main">
        <div class="container">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="gs-footer">
        &copy; 2026 GameStore &mdash; Todos los derechos reservados
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>